# Copy to .env for local development. On Replit, put these in the Secrets pane.
# Never commit real values.

# Replit PostgreSQL (set automatically when you create the database).
DATABASE_URL=postgres://postgres@localhost:5432/restocool

# Clerk (https://dashboard.clerk.com → API keys). Organizations must be enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → your endpoint → Signing secret (starts with whsec_).
CLERK_WEBHOOK_SECRET=

# Public URL of the app, without trailing slash.
APP_URL=http://localhost:5000

# Signs staff PIN sessions and QR tokens (M3/M5). Generate: openssl rand -base64 48
SESSION_SECRET=

# Comma-separated emails with TIBLOGICS super admin access (must be verified in Clerk).
SUPERADMIN_EMAILS=

# 32-byte key (base64) that encrypts payment provider credentials (M5). Generate: openssl rand -base64 32
PAYMENT_ENCRYPTION_KEY=

# Local development only: without Clerk keys, act as the owner of the demo restaurant.
# Ignored in production builds.
DEV_AUTH_BYPASS=1
