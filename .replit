# RestoCool on Replit (Next.js 15 + Drizzle + Replit PostgreSQL).
#
# Before the first run:
#   1. Database pane -> create PostgreSQL (sets DATABASE_URL automatically).
#   2. Secrets pane  -> add the variables listed in .env.example.
#   3. Shell: npm run db:migrate && npm run db:seed
#
# Deployment: Reserved VM (one long-lived process, needed for live order
# updates over SSE + Postgres LISTEN/NOTIFY from M4). Migrations run on start.

modules = ["nodejs-22", "postgresql-16"]
run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm run db:migrate && (npm run import:shangri-la -- --if-missing || true) && npm run start"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
NEXT_TELEMETRY_DISABLED = "1"

# Run button: start the dev server and open the preview on port 5000.
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RestoCool Web"

[[workflows.workflow]]
name = "RestoCool Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[objectStorage]
defaultBucketID = "replit-objstore-4ddd9872-6bf5-454a-991e-b05d5f2e9e6f"
