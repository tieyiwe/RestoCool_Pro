    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.23",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
